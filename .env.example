# Which client src/llm/index.ts creates: openai | backboard | ollama | backboard_ollama (GPT writes, local model enforces the schema)
LLM_PROVIDER=openai

# Backboard (https://app.backboard.io)
BACKBOARD_API_KEY=
BACKBOARD_LLM_PROVIDER=openai
BACKBOARD_MODEL=gpt-5.4-nano
# Reasoning effort for models that support it: low | medium | high | max (leave empty to turn off)
BACKBOARD_REASONING_EFFORT=medium

# Ollama (local). Must be a GGUF model (e.g. qwen3.5:9b-q4_K_M): MLX models can't enforce a schema.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b-q4_K_M

# OpenAI (https://platform.openai.com/api-keys). Enforces the schema itself (strict mode), so one call per form.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Reasoning effort: none | minimal | low | medium | high (supported values depend on the model).
# Leave empty for non-reasoning models (gpt-4.1*, gpt-4o-mini), which reject it.
OPENAI_REASONING_EFFORT=low
# Optional: only change for an OpenAI-compatible proxy
# OPENAI_BASE_URL=https://api.openai.com/v1
